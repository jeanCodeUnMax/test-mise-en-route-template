{
  "enabled": true,
  "master_file": "docs/master/PROJECT_MASTER.md",
  "require_initialized_project": true,
  "required_sections": [
    "MISSION",
    "HYPOTHESIS_ACTIVE",
    "EXPERIMENT_ACTIVE",
    "TASK_ACTIVE",
    "SUCCESS_CRITERION",
    "LAST_CONCLUSION",
    "NEXT_ACTION"
  ],
  "require_master_task_sync": true,
  "require_active_task_when_tasks_exist": true,
  "require_task_done_when": true,
